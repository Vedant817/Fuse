[
  {
    "policyVersion": "fuse-production-v1",
    "scope": {
      "tenant": "*",
      "environment": "*",
      "agentId": "*"
    },
    "cooldownSeconds": 300,
    "storeOutageMode": "fail-closed",
    "controlPlaneOutageMode": "fail-closed",
    "detectors": {
      "loop-signature": {
        "windowSize": 40,
        "minRepetitions": 3,
        "maxCycleLength": 4
      },
      "context-bloat": {
        "absoluteCeilingTokens": 100000,
        "minConsecutiveGrowthSteps": 5,
        "minGrowthRatio": 3,
        "minInputTokensForGrowthSignal": 8000,
        "minStepsRequired": 4
      },
      "cost-velocity": {
        "windowMs": 60000,
        "thresholdUsdPerWindow": 0.5,
        "minCallsForSignal": 3,
        "minElapsedMsForSignal": 2000
      }
    },
    "notificationRoutes": ["slack"]
  }
]
