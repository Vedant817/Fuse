[
  {
    "alert": "fuse-operational-permit-p95-v1",
    "alertType": "METRIC_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "schemaVersion": "v2alpha1",
    "condition": {
      "compositeQuery": {
        "queryType": "builder",
        "panelType": "graph",
        "unit": "s",
        "queries": [
          {
            "type": "builder_query",
            "spec": {
              "name": "A",
              "signal": "metrics",
              "stepInterval": 60,
              "filter": {
                "expression": "fuse.slo.version = 'v1-provisional'"
              },
              "aggregations": [
                {
                  "metricName": "fuse.control_plane.permit.duration",
                  "timeAggregation": "p95",
                  "spaceAggregation": "max"
                }
              ]
            }
          }
        ]
      },
      "selectedQueryName": "A",
      "alertOnAbsent": false,
      "absentFor": 5,
      "thresholds": {
        "kind": "basic",
        "spec": [
          {
            "name": "warning",
            "op": "above",
            "matchType": "all_the_times",
            "target": 0.05,
            "targetUnit": "s",
            "channels": ["fuse-operations"]
          }
        ]
      }
    },
    "evaluation": {
      "kind": "rolling",
      "spec": { "evalWindow": "5m", "frequency": "1m" }
    },
    "notificationSettings": {
      "groupBy": [],
      "usePolicy": false,
      "renotify": { "enabled": false, "interval": "30m", "alertStates": [] }
    },
    "labels": {
      "severity": "warning",
      "fuse_signal": "permit-p95",
      "fuse_slo_version": "v1-provisional"
    },
    "annotations": {
      "summary": "Permit p95 exceeds provisional 50 ms objective",
      "description": "Opens after every evaluated point in 5m exceeds 50 ms; resolves when the rolling condition clears. Idle traffic is not no-data. See docs/runbooks/operations.md#provisional-operational-slos."
    }
  },
  {
    "alert": "fuse-operational-permit-error-rate-v1",
    "alertType": "METRIC_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "schemaVersion": "v2alpha1",
    "condition": {
      "compositeQuery": {
        "queryType": "builder",
        "panelType": "graph",
        "unit": "percent",
        "queries": [
          {
            "type": "builder_query",
            "spec": {
              "name": "A",
              "signal": "metrics",
              "stepInterval": 60,
              "disabled": true,
              "filter": {
                "expression": "fuse.slo.version = 'v1-provisional' AND fuse.outcome IN ['degraded', 'server_error']"
              },
              "aggregations": [
                {
                  "metricName": "fuse.control_plane.permit.requests",
                  "timeAggregation": "rate",
                  "spaceAggregation": "sum"
                }
              ]
            }
          },
          {
            "type": "builder_query",
            "spec": {
              "name": "B",
              "signal": "metrics",
              "stepInterval": 60,
              "disabled": true,
              "filter": {
                "expression": "fuse.slo.version = 'v1-provisional'"
              },
              "aggregations": [
                {
                  "metricName": "fuse.control_plane.permit.requests",
                  "timeAggregation": "rate",
                  "spaceAggregation": "sum"
                }
              ]
            }
          },
          {
            "type": "builder_formula",
            "spec": { "name": "F1", "expression": "(A / B) * 100" }
          }
        ]
      },
      "selectedQueryName": "F1",
      "alertOnAbsent": false,
      "absentFor": 5,
      "thresholds": {
        "kind": "basic",
        "spec": [
          {
            "name": "critical",
            "op": "above",
            "matchType": "at_least_once",
            "target": 0.1,
            "channels": ["fuse-operations"]
          }
        ]
      }
    },
    "evaluation": {
      "kind": "rolling",
      "spec": { "evalWindow": "5m", "frequency": "1m" }
    },
    "notificationSettings": {
      "groupBy": [],
      "usePolicy": false,
      "renotify": { "enabled": false, "interval": "30m", "alertStates": [] }
    },
    "labels": {
      "severity": "critical",
      "fuse_signal": "permit-error-rate",
      "fuse_slo_version": "v1-provisional"
    },
    "annotations": {
      "summary": "Permit error rate exceeds provisional 0.1% objective",
      "description": "Degraded unknown-state decisions and server errors consume this budget. Opens on a 5m breach and resolves when the rolling rate clears; idle is not no-data."
    }
  },
