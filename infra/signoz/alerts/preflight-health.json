{
  "alert": "fuse-preflight-health",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "evalWindow": "1m",
  "frequency": "15s",
  "condition": {
    "compositeQuery": {
      "queryType": "builder_query",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": "60s",
            "groupBy": [
              { "name": "fuse.tenant" },
              { "name": "fuse.environment" },
              { "name": "fuse.agent_id" }
            ],
            "aggregations": [
              {
                "metricName": "fuse.preflight.self_alert.active",
                "temporality": "unspecified",
                "timeAggregation": "latest",
                "spaceAggregation": "max"
              }
            ]
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "op": "above_or_equal",
    "target": 1,
    "matchType": "at_least_once"
  },
  "labels": { "severity": "critical", "fuse_signal": "preflight-health" },
  "annotations": {
    "summary": "Fuse protection degraded for {{$labels.fuse_agent_id}}",
    "description": "Preflight no longer has current, acknowledged OTLP delivery for this scope. Inspect fuse.preflight.self_alert.transitions for the reason code, restore the agent exporter, and wait for the configured recovery dwell. This alert is advisory and does not synchronously gate detector enforcement."
  },
  "disabled": false,
  "preferredChannels": ["fuse-preflight-health"]
}
