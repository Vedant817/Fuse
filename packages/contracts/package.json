    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/policy.d.ts",
    "dist/policy.d.ts.map",
    "dist/policy.js",
    "dist/policy.js.map",
    "dist/preflight.d.ts",
    "dist/preflight.d.ts.map",
    "dist/preflight.js",
    "dist/preflight.js.map",
    "dist/scope-registration.d.ts",
    "dist/scope-registration.d.ts.map",
    "dist/scope-registration.js",
    "dist/scope-registration.js.map",
    "dist/scope.d.ts",
    "dist/scope.d.ts.map",
    "dist/scope.js",
