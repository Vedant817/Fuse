    "dist/breaker-state.d.ts",
    "dist/breaker-state.d.ts.map",
    "dist/breaker-state.js",
    "dist/breaker-state.js.map",
    "dist/detector-observation.d.ts",
    "dist/detector-observation.d.ts.map",
    "dist/detector-observation.js",
    "dist/detector-observation.js.map",
    "dist/detector.d.ts",
    "dist/detector.d.ts.map",
    "dist/detector.js",
