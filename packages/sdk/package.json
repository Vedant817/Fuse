{
  "name": "@fuse/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./demo": {
      "types": "./dist/demo-threshold-trigger.d.ts",
      "default": "./dist/demo-threshold-trigger.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .typecheck.tsbuildinfo",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@fuse/contracts": "workspace:*"
  },
  "devDependencies": {
    "@fuse/breaker-store": "workspace:*",
    "@fuse/control-plane": "workspace:*",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/pg": "^8.11.10",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
