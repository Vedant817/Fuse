{
  "name": "@fuse/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .typecheck.tsbuildinfo",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@fuse/breaker-core": "workspace:*",
    "@fuse/breaker-store": "workspace:*",
    "@fuse/contracts": "workspace:*",
    "@fuse/detectors": "workspace:*",
    "@fuse/diagnosis": "workspace:*",
    "@fuse/otel": "workspace:*",
    "@fuse/preflight": "workspace:*",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
