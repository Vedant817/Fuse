{
  "name": "fuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fuse — a cost circuit breaker for AI agents, powered by SigNoz",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "package:pack": "node tools/package-smoke/run.mjs --pack-only",
    "test:package-consumer": "node tools/package-smoke/run.mjs",
    "test:release-workflow": "node tools/release/validate-workflow.mjs",
    "test:signoz-alerts": "node --test tools/signoz-alerts/contract.test.mjs",
    "test:deployment-contracts": "node --test tools/deployment/contract.test.mjs",
    "test:openapi": "node --test tools/openapi/validator.test.mjs && node tools/openapi/validate.mjs && pnpm --filter @fuse/control-plane... run build && node --test tools/openapi/conformance.test.mjs",
    "validate:production-env": "node tools/deployment/validate-control-plane-env.mjs",
    "check": "pnpm run format && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run test:openapi && pnpm run test:signoz-alerts && pnpm run test:deployment-contracts",
    "check:full": "pnpm run check && pnpm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "yaml": "2.9.0"
  }
}
