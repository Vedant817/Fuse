# Copy to .env and fill in real values. Never commit the real .env file.

# --- Control plane ---
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_HOST=0.0.0.0
LOG_LEVEL=info

# Fail-open ("permit") or fail-closed ("deny") when the state store is
# unreachable during a permit check. Production default is fail-closed;
# demo environments may override with explicit, visible justification.
CONTROL_PLANE_STORE_OUTAGE_MODE=fail-closed

# --- Postgres (breaker state + audit store) ---
DATABASE_URL=postgres://fuse:fuse@localhost:5432/fuse

# --- Webhook / API authentication (placeholders only) ---
# Operator bearer token(s): full access, including force-trip/resume/
# disable/enable. Never give these to an agent-embedded SDK or the SigNoz
# webhook channel.
CONTROL_PLANE_API_TOKENS=changeme-generate-a-strong-random-token
# Agent bearer token(s), optional: permit-check only. This is what an
# agent process's FuseGuard should actually be configured with — it cannot
# resume, disable, or force-trip any breaker even if it tries.
CONTROL_PLANE_AGENT_API_TOKENS=changeme-generate-a-different-strong-random-token
# Webhook bearer token(s), optional: SigNoz's alert-webhook channel only.
# SigNoz has no HMAC-signing option for webhooks (verified against its
# current docs) — configure its webhook channel with an empty username and
# this token as the password, which SigNoz sends as a bearer token. A
# leaked webhook token can only cause a trip for the scope named in an
# alert's own labels — it cannot resume, disable, or force-trip anything.
CONTROL_PLANE_WEBHOOK_TOKENS=changeme-generate-a-third-strong-random-token
# Server-controlled defaults applied to every trip the webhook causes —
# deliberately not read from the alert payload itself (untrusted input).
CONTROL_PLANE_WEBHOOK_POLICY_VERSION=signoz-webhook-v1
CONTROL_PLANE_WEBHOOK_COOLDOWN_SECONDS=300

# --- SDK ---
FUSE_CONTROL_PLANE_URL=http://localhost:8080
FUSE_PERMIT_TIMEOUT_MS=300
# Fail-open ("permit") or fail-closed ("deny") when the SDK cannot reach the
# control plane before a model call. Production default is fail-closed.
FUSE_SDK_OUTAGE_MODE=fail-closed

# --- Real LLM provider adapters (ADR-003) ---
# Only needed to run the live-optional provider tests
# (`pnpm --filter @fuse/sdk run test:live`) or the real (non-mocked) demo
# agent path. Leave unset to keep everything on the mock/fake-provider path.
GROQ_API_KEY=
NVIDIA_API_KEY=
