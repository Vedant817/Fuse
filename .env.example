# Copy to .env and fill in real values. Never commit the real .env file.

# --- Control plane ---
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_HOST=0.0.0.0
LOG_LEVEL=info
# OTel resource attribute (deployment.environment.name) for the control
# plane's own traces/metrics — distinct from a request's per-scope
# `environment`, which identifies the calling agent's environment, not the
# control plane process's own deployment.
CONTROL_PLANE_DEPLOYMENT_ENVIRONMENT=development

# Fail-open ("permit") or fail-closed ("deny") when the state store is
# unreachable during a permit check. Production default is fail-closed;
# demo environments may override with explicit, visible justification.
CONTROL_PLANE_STORE_OUTAGE_MODE=fail-closed

# --- Postgres (breaker state + audit store) ---
DATABASE_URL=postgres://fuse:fuse@localhost:5432/fuse

# Optional pool overrides for the /v1/permit hot path (defaults below match
# @fuse/breaker-store's hardcoded fallbacks — uncomment only to change them).
# Raising CONTROL_PLANE_DB_POOL_MAX allows more concurrent DB connections
# for permit checks, at the cost of more load on the Postgres server.
# CONTROL_PLANE_DB_POOL_MAX=10
# CONTROL_PLANE_DB_POOL_IDLE_TIMEOUT_MS=30000
# CONTROL_PLANE_DB_POOL_CONNECTION_TIMEOUT_MS=2000
# CONTROL_PLANE_DB_STATEMENT_TIMEOUT_MS=5000
# Per-tenant cap on operator-registered scope tuples. Unknown scopes are
# rejected and never lazily create durable state or metric label sets.
# CONTROL_PLANE_MAX_REGISTERED_SCOPES_PER_TENANT=10000

# Global request limiter, keyed by bearer token for authenticated traffic.
# Size this above the peak aggregate permit rate of every agent sharing one
# token; the SDK treats a 429 as control-plane unavailability and applies its
# configured fail-open/fail-closed policy.
CONTROL_PLANE_RATE_LIMIT_MAX=120
CONTROL_PLANE_RATE_LIMIT_WINDOW_MS=60000

# --- Webhook / API authentication (placeholders only) ---
# Each entry below is comma-separated and either a plain token (valid for
# EVERY tenant — the wildcard/back-compat form) or a `tenant:token` pair
# (valid only for that tenant's own scope). Mixing both forms in one list
# is fine, e.g. `changeme-wildcard-token,acme-corp:changeme-acme-token`.
# Plain tokens are an explicit escape hatch, not the recommended shape for
# a real multi-tenant deployment — see docs/adr/004-tenant-scoped-tokens.md
# and docs/threat-model.md §4 for why a leaked wildcard token controls
# every tenant's breaker, and prefer `tenant:token` once you have more than
# one tenant on a single deployment.
#
# Operator bearer token(s): full access, including force-trip/resume/
# disable/enable. Never give these to an agent-embedded SDK or the SigNoz
# webhook channel.
CONTROL_PLANE_API_TOKENS=changeme-generate-a-strong-random-token
# Agent bearer token(s), optional: permit-check only. This is what an
# agent process's FuseGuard should actually be configured with — it cannot
# resume, disable, or force-trip any breaker even if it tries.
CONTROL_PLANE_AGENT_API_TOKENS=changeme-generate-a-different-strong-random-token
# Webhook bearer token(s), optional: SigNoz's alert-webhook channel only.
# SigNoz has no HMAC-signing option for webhooks (verified against its
# current docs) — configure its webhook channel with an empty username and
# this token as the password, which SigNoz sends as a bearer token. A
# leaked webhook token can only cause a trip — never resume, disable, or
# force-trip. Prefer `tenant:token`; every alert in a grouped delivery must
# then name that tenant. Use a plain wildcard token only when one SigNoz
# instance intentionally monitors multiple tenants.
CONTROL_PLANE_WEBHOOK_TOKENS=changeme-generate-a-third-strong-random-token
# Server-controlled defaults applied to every trip the webhook causes —
# deliberately not read from the alert payload itself (untrusted input).
CONTROL_PLANE_WEBHOOK_POLICY_VERSION=signoz-webhook-v1
CONTROL_PLANE_WEBHOOK_COOLDOWN_SECONDS=300
# Replay/staleness guard (docs/threat-model.md §3): an alert whose startsAt
# is older than this many milliseconds is rejected per-alert (never trips),
# guarding against a captured HTTP request being replayed long after it
# stopped being relevant. Does NOT prevent an attacker holding a valid
# webhook token from minting a brand-new, currently-fresh forged alert —
# SigNoz has no payload-signing option, so that remains an accepted,
# documented limitation.
CONTROL_PLANE_WEBHOOK_MAX_ALERT_AGE_MS=600000
# Tolerance for startsAt claiming to be slightly in the future (clock skew
# between SigNoz and the control plane) before it's treated as suspicious.
CONTROL_PLANE_WEBHOOK_MAX_CLOCK_SKEW_MS=60000

# Startup-validated detector policy JSON. Required when
# CONTROL_PLANE_DEPLOYMENT_ENVIRONMENT=production; local development may
# omit it to use the library defaults. The Kubernetes example mounts this
# path from a ConfigMap.
# CONTROL_PLANE_DETECTOR_POLICY_FILE=/etc/fuse/policies/production.json

# --- Preflight evaluator thresholds (optional overrides) ---
# Defaults below match @fuse/preflight's DEFAULT_PREFLIGHT_CONFIG exactly —
# uncomment only to change them. Preflight's whole value is honestly
# reporting protection status for whatever deployment is actually running;
# a legitimately low-traffic or bursty agent may need these widened so it
# isn't perpetually reported degraded/blind. Widening the window/staleness/
# dwell values trades faster false-positive noise for slower detection of a
# genuine telemetry regression — tighten them instead for an agent where
# fast detection matters more than tolerance for gaps.
# CONTROL_PLANE_PREFLIGHT_WINDOW_MS=300000
# CONTROL_PLANE_PREFLIGHT_BLIND_COVERAGE_THRESHOLD=0.5
# CONTROL_PLANE_PREFLIGHT_BLIND_ORPHAN_RATE_THRESHOLD=0.5
# CONTROL_PLANE_PREFLIGHT_BLIND_TOKEN_MISSING_RATE_THRESHOLD=0.3
# CONTROL_PLANE_PREFLIGHT_HEARTBEAT_GRACE_MS=120000
# CONTROL_PLANE_PREFLIGHT_MAX_EVIDENCE_STALENESS_MS=300000
# CONTROL_PLANE_PREFLIGHT_MIN_RECOVERY_DWELL_MS=60000

# --- SDK ---
FUSE_CONTROL_PLANE_URL=http://localhost:8090
# Deadline (ms) for the permit check itself, not the wrapped model call.
# Read by services/broken-agent/src/demo.ts's FuseGuard construction; must be
# a positive integer or it is ignored with a startup warning and FuseGuard's
# own built-in default (300ms) is used instead — never silently misapplied.
FUSE_PERMIT_TIMEOUT_MS=300
# Fail-open ("permit") or fail-closed ("deny") when the SDK cannot reach the
# control plane before a model call. Production default is fail-closed. Must
# be exactly "fail-open" or "fail-closed"; any other value is ignored with a
# startup warning and falls back to fail-closed, the safer default.
FUSE_SDK_OUTAGE_MODE=fail-closed

# --- Real LLM provider adapters (ADR-003) ---
# Only needed to run the live-optional provider tests
# (`pnpm --filter @fuse/sdk run test:live`) or the real (non-mocked) demo
# agent path. Leave unset to keep everything on the mock/fake-provider path.
GROQ_API_KEY=
NVIDIA_API_KEY=

# --- OTel export target (ADR-005: self-hosted SigNoz, not SigNoz Cloud) ---
# `bootstrapOtel` (packages/otel) falls back to these standard OTEL_
# variables whenever no explicit endpoint/headers are passed in code. Point
# them at the local self-hosted SigNoz stack started by
# `infra/signoz-up.sh` (see docs/adr/005-self-hosted-signoz.md); no
# ingestion key/auth header is needed for a local, unauthenticated
# collector. Never expose this port beyond localhost.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Local dev credentials for the self-hosted SigNoz UI (http://localhost:8080),
# created by infra/signoz-up.sh's first-run bootstrap. Fixed, publicly-known
# local defaults — never reuse these anywhere real, and never expose this
# deployment beyond localhost.
SIGNOZ_ADMIN_EMAIL=admin@fuse.local
SIGNOZ_ADMIN_PASSWORD=FuseLocalDev123!

# --- Diagnosis (task.md §7): SigNoz MCP evidence + Slack incident cards ---
# A service-account API key with the least-privilege `signoz-viewer` role
# (Settings -> Service Accounts in the SigNoz UI, NOT the admin session
# above) — see docs/adr/007-signoz-mcp-diagnosis.md for exactly how this
# was created. Passed to the signoz-mcp Docker service (infra/
# docker-compose.yml, profile "diagnosis"), never read by the control
# plane directly.
SIGNOZ_API_KEY=
# Where the control plane reaches the signoz-mcp server (started via
# `docker compose --profile diagnosis up -d signoz-mcp`). Leave unset to
# make diagnosis honestly report "evidence unavailable" instead of
# fetching real traces — never a silent/undetectable degradation.
FUSE_SIGNOZ_MCP_URL=http://localhost:8020/mcp
# Slack bot token (`xoxb-...`) for posting incident cards via
# chat.postMessage/views.open. Leave unset to keep diagnosis fully
# functional (local HTML snapshot only) without a Slack workspace — see
# task.md §7.3.
SLACK_BOT_TOKEN=
# Use the channel/conversation ID shown by Slack (starts with C), not the
# display name. chat.postMessage can return channel_not_found for #name even
# when the bot is correctly installed and invited.
SLACK_INCIDENT_CHANNEL=C0123456789
# Slack's signing secret (App settings -> Basic Information), required to
# verify POST /v1/slack/interactive really came from Slack. Fail-closed:
# leaving this unset makes every interactive request (resume-button
# clicks) rejected with 401, never silently accepted unverified.
SLACK_SIGNING_SECRET=
# Where runDiagnosisAndNotify writes a local, no-network HTML snapshot of
# every incident card — reliable for demo rehearsal without depending on
# Slack being reachable/configured.
FUSE_INCIDENT_SNAPSHOT_DIR=/tmp/fuse-incidents
